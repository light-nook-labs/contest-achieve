[{"nid":552804,"title":"你与华饰的公主","author":"黄朱","form_id":3,"intro":"花树下埋着尸体。","cover":"https://rs.sfacg.com/web/novel/images/NovelCover/Big/2022/10/41eb94e4-7f86-4c2d-bb86-f3e18ebac7b8.jpg"},{"nid":549546,"title":"主角未免太多了点吧！？","author":"骑可石白","form_id":3,"intro":"无数的对话框向我袭来，庞大的信息文字让我目不暇接。\n不是...这个时间的主人公们未免也太多了一点吧！？\n各种不同的轻小说主人公类型聚在一起会发生怎样的化学反应呢？","cover":"https://rs.sfacg.com/web/novel/images/NovelCover/Big/2022/05/5214c808-d9d9-41de-af1c-2eb9d86b56ef.jpg"},{"nid":550302,"title":"一堂历史课","author":"呆子白三","form_id":3,"intro":"今天下午上历史课的时候，我的同学跳楼了……","cover":"https://rs.sfacg.com/web/novel/images/NovelCover/Big/2023/01/47f4d5ed-72fc-4b48-b935-eb3fc4e08866.jpg"}]
